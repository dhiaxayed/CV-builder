# ============================================
# CV Builder Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# SUPABASE (Required)
# ============================================
# Get your Supabase credentials at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key

# Optional: Service role key for admin operations (keep secret, never expose to client!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# APP URL (Required for auth)
# ============================================
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (update with your actual domain)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================
# EMAIL (Optional - defaults to console logging)
# ============================================
# Email provider: 'console' (dev), 'resend' (recommended), 'smtp'
EMAIL_PROVIDER=console

# Resend (recommended for production)
# Sign up at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@your-domain.com

# ============================================
# PDF GENERATION (Optional)
# ============================================
# LaTeX command for server-side PDF rendering.
# This selects an installed binary; it does not install LaTeX on serverless hosts.
# LATEX_CMD=xelatex

# ============================================
# GROQ AI (Optional - enables AI ATS review and job tailoring)
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=45000
