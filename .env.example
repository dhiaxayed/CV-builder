# ============================================
# CV Builder Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# SUPABASE (Required)
# ============================================
# Get your Supabase credentials at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key
# Optional private runtime URL; otherwise the public URL above is used.
# SUPABASE_URL=https://your-project.supabase.co

# Required: server-only credential for custom sessions and private data. Never expose in the browser.
# Set either the modern secret key or the legacy service-role key. Modern takes precedence.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# APP URL (Required for auth)
# ============================================
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (update with your actual domain)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================
# EMAIL (Development console mode or a production email provider)
# ============================================
# Email provider: 'console' (dev), 'resend' (recommended), 'smtp'
EMAIL_PROVIDER=console

# Resend (recommended for production)
# Sign up at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@your-domain.com

# ============================================
# PDF GENERATION (Optional)
# ============================================
# LaTeX renderer for server-side PDF rendering.
# Vercel: LATEX_RENDERER=tectonic
# Docker/VPS: LATEX_RENDERER=auto
LATEX_RENDERER=auto
# LATEX_CMD=xelatex

# ============================================
# GROQ AI (Optional - enables AI ATS review and job tailoring)
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=10000

# Existing OpenRouter deployments are also supported. Groq wins if both keys exist.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=25000

# Set only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY_HEADERS=0
