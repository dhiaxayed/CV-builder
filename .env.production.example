# Copy this file to .env.production and fill with real values.
# Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Set one server credential: modern secret key (preferred), or legacy service_role.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional private runtime URL; keep it aligned with the chosen environment.
# SUPABASE_URL=https://your-project.supabase.co

# App URL (must match your public domain)
NEXT_PUBLIC_APP_URL=https://your-domain.com
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=10000

# Alternative provider; used when GROQ_API_KEY is empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=25000

# Email SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=CV Builder <your-email@gmail.com>

# PDF rendering
# Vercel: use the bundled Tectonic engine.
# Docker/VPS: auto uses xelatex/pdflatex when available, then Tectonic fallback.
LATEX_RENDERER=tectonic
# LATEX_CMD=xelatex

# Set only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY_HEADERS=0
