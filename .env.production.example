# Copy this file to .env.production and fill with real values.
# Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# App URL (must match your public domain)
NEXT_PUBLIC_APP_URL=https://your-domain.com
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=45000

# Email SMTP
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=CV Builder <your-email@gmail.com>

# PDF rendering
# Vercel: use the bundled Tectonic engine.
# Docker/VPS: auto uses xelatex/pdflatex when available, then Tectonic fallback.
LATEX_RENDERER=tectonic
# LATEX_CMD=xelatex
